classDiagram
    class Drawable <<interface>> {
        +draw()
    }
    class Stack~T~ {
        +List~T~ items
        +push(item) void
    }
    class Animal {
        +String name
        +int age
        +eat()
    }
    class Dog {
        +bark()
        +draw()
    }
    class Cat
    note for Animal "base living creature"
    Animal <|-- Dog : inherits
    Animal <|-- Cat
    Animal "1" --> "*" Food : eats
    Dog ..|> Drawable
    Customer "1" --> "*" Order : places
    Stack~T~ --> Object : stores
